# ================================================================
# Mycellis frontend — environment variables reference.
# Vite only exposes vars prefixed VITE_ to client code. This is
# currently the only one referenced anywhere in src/ (see
# src/lib/api/client.ts).
# ================================================================

# ---- API config ----

# Backend API base URL. Leave empty in dev — Vite's dev proxy
# (vite.config.ts) forwards /api/* and /actuator/* to localhost:8080,
# so requests work same-origin without this being set.
# Set as a Cloudflare Pages environment variable in production:
#   VITE_API_BASE_URL=https://api.mycellis.dev
VITE_API_BASE_URL=
