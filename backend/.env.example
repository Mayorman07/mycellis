# ================================================================
# Mycellis backend — environment variables reference.
#
# Spring Boot does not auto-load this file. In production these are set
# as Fly secrets (`fly secrets set VAR=value`); locally, export them in
# your shell or your IDE's run configuration if you want the optional
# features below (admin seeding, Resend email) to work.
#
# The dev profile (application-dev.properties) needs NONE of these to
# boot — database credentials are hardcoded to match docker-compose.yml,
# and every optional var below defaults to "skip this feature" when unset.
# ================================================================

# ---- Database (Neon Postgres in production; not used in dev — dev
#      connects to the local Docker Postgres from docker-compose.yml) ----

# Full Postgres connection string from the Neon console, in
# postgres://user:pass@host/db?sslmode=require form. Auto-parsed at boot
# (see DatabaseUrlConfiguration) into the three spring.datasource.*
# properties — you normally only need to set this one variable.
DATABASE_URL=postgres://xxx:xxx@xxxxx.neon.tech/mycellis?sslmode=require

# Fallback only — used if DATABASE_URL doesn't carry embedded credentials
# (e.g. it's already in jdbc:postgresql:// form). Not needed alongside a
# Neon-style DATABASE_URL above.
DATABASE_USERNAME=xxx
DATABASE_PASSWORD=xxx

# ---- Email (Resend in production; MailHog via SMTP in dev — see
#      docker-compose.yml, no vars needed for that) ----

# Switches which EmailService implementation is active. Must be "resend"
# in production, or the app fails to start if RESEND_API_KEY /
# MYCELIS_EMAIL_FROM are blank. Defaults to "smtp" (dev's MailHog) if unset.
MYCELIS_EMAIL_PROVIDER=resend

# Resend API key. Resend dashboard -> API keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender address on the Resend account. Must match a domain
# verified in Resend (send.mycellis.dev in production).
MYCELIS_EMAIL_FROM=Mycellis <noreply@send.mycellis.dev>

# Legacy SMTP settings. Spring Boot's mail autoconfiguration binds
# spring.mail.* eagerly regardless of MYCELIS_EMAIL_PROVIDER, but these
# are inert while the Resend provider is active. Safe to leave unset.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=xxx
MAIL_PASSWORD=xxx

# ---- Auth / admin seed ----

# All five below are optional. If MYCELIS_ADMIN_EMAIL is blank, the seeder
# skips cleanly on boot. If it's set and a user with that email already
# exists, the seeder ALSO skips — this only creates a NEW super-admin, it
# does not rotate an existing one's password. To change an existing
# admin's password, use the app's own Settings -> Change Password instead.
MYCELIS_ADMIN_EMAIL=xxx@xxx.xxx
MYCELIS_ADMIN_PASSWORD=xxx
MYCELIS_ADMIN_MOBILE=xxx
# Defaults to "Admin" if unset.
MYCELIS_ADMIN_FIRST_NAME=xxx
# Defaults to "User" if unset.
MYCELIS_ADMIN_LAST_NAME=xxx

# ---- App URLs ----

# Required in production — no default, boot fails if unset.
# Public frontend URL, used in email links (verification, password reset).
FRONTEND_URL=https://mycellis.dev
# Required in production — no default. This API's own public URL.
BACKEND_URL=https://api.mycellis.dev
# Required in production — no default, despite being deprecated in favor
# of the two vars above. Kept for backward compatibility; not yet removed.
APP_BASE_URL=https://api.mycellis.dev

# ---- Server config ----

# Optional, defaults to 8080. Already set statically in fly.toml — you
# shouldn't normally need to override this yourself.
SERVER_PORT=8080
# Optional, defaults to 8081. Actuator (health/metrics) port, bound to
# 127.0.0.1 only in production — not reachable from outside the Fly VM.
MANAGEMENT_PORT=8081

# ---- CORS ----

# Optional, defaults to https://mycellis.dev. Comma-separated for multiple
# allowed origins (e.g. apex + www).
CORS_ALLOWED_ORIGINS=https://mycellis.dev,https://www.mycellis.dev
